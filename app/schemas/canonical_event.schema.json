{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiedge.local/schemas/canonical_event.schema.json",
  "title": "AI-EDGE Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "data_plane"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": ["content", "access"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "data_plane": {
      "type": "string",
      "enum": ["content", "access"]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "text"],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "enum": ["PII", "financial", "policy", "internal", "public"]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "role",
        "department",
        "resource_id",
        "resource_class",
        "action"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_class": {
          "type": "string",
          "enum": ["PII", "financial", "policy", "internal", "public"]
        },
        "action": {
          "type": "string",
          "enum": ["read", "search", "download", "update", "bulk_download", "delete", "privilege_change"]
        },
        "source_ip": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": ["content"],
      "properties": {
        "event_type": { "const": "content" },
        "data_plane": { "const": "content" }
      }
    },
    {
      "required": ["access"],
      "properties": {
        "event_type": { "const": "access" },
        "data_plane": { "const": "access" }
      }
    }
  ]
}
